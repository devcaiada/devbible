# Application Environment Configuration
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://example.com

# PostgreSQL Credentials
POSTGRES_USER=devbible_user
POSTGRES_PASSWORD=super_secure_random_db_password_123!
POSTGRES_DB=devbible_production

# Redis Credentials
REDIS_PASSWORD=super_secure_random_redis_password_123!

# JWT & Authentication Secrets
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
